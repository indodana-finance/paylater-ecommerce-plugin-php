# MySQL (shared across all versions)
MYSQL_ROOT_PASSWORD=magento_root
MYSQL_USER=magento
MYSQL_PASSWORD=magento

# RabbitMQ
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=magento

# Magento Admin
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com

# Magento Repo Auth (REQUIRED)
# Get keys from https://commercemarketplace.adobe.com/
# Public key = username, Private key = password
COMPOSER_AUTH={"http-basic":{"repo.magento.com":{"username":"YOUR_PUBLIC_KEY","password":"YOUR_PRIVATE_KEY"}}}
